# Detect text files and store them with LF line endings
* text=auto

# Allow Large File Storage
bin/* filter=lfs diff=lfs merge=lfs -text

# Ignore .yy files for language statistics
*.yy linguist-generated=true

# force LF for metadata files for merge simplicity
*.gml text eol=lf
*.yy text eol=lf
*.yyp text eol=lf
*.json text eol=lf

# Text files that always use LF
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Windows scripts that always use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files that are never converted or diffed as text
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.ico binary
*.webp binary
*.wav binary
*.ogg binary
*.mp3 binary
*.flac binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.zip binary
*.7z binary
*.gz binary
*.pdf binary
*.exe binary
*.dll binary
